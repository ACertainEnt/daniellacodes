# ─────────────────────────────────────────────────────────────
# DANIELLACODES — server configuration (server-side ONLY)
# Copy to .env and fill in. NEVER prefix a secret with VITE_.
# ─────────────────────────────────────────────────────────────

PORT=5173
NODE_ENV=development

# Secret used to sign the httpOnly session cookie. Use a long random string.
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-characters

# Two seeded accounts. No public registration exists.
# Account identifiers are login IDs, not email addresses, in local mode.
STUDENT_ACCOUNT_ID=DANIELLACODES
STUDENT_PASSWORD=replace-with-daniellas-password
STUDENT_DISPLAY_NAME=Daniella
INSTRUCTOR_ACCOUNT_ID=ACECODES
INSTRUCTOR_PASSWORD=replace-with-aces-password
INSTRUCTOR_DISPLAY_NAME=Divine (Ace)

# Where the persistent SQLite file lives (local runtime).
DATABASE_PATH=./data/daniellacodes.db

# ── Optional: production Supabase mode ────────────────────────
# Leave DATA_DRIVER unset to run the self-contained local runtime.
# Set DATA_DRIVER=supabase to use Supabase Auth + Postgres + Storage.
# SUPABASE_SERVICE_ROLE_KEY is a SECRET and is only ever read on the server.
# DATA_DRIVER=sqlite
# AUTH_MODE=local
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# VITE_SUPABASE_URL=            # public URL is fine, but the app never uses it directly
# VITE_SUPABASE_ANON_KEY=       # anon key is safe to expose, never the service-role key
